#include<stdio.h>
#include<string.h>
int main()
{
	//编写程序，从屏幕上随意输入一串字符，然后统计这个字符串中某特定字符（从屏幕上输入）出现的次数和位置。
	char str[256],ch;
	int i,count=0;
	
	printf("请输入字符:");
	fgets(str,sizeof(str),stdin);
	str[strcspn(str,"\n")] = '\0';
	                                                
	printf("统计查找该字符"); 
	scanf(" %c",&ch)	;

    printf("字符%c出现的位置\n",ch);
    for(i=0;str[i]!='\0';i++)
    {
    	if(str[i]==ch)
		{
    		count++;
    		printf("%d\t\n",i+1);
    	}
		
	}
	printf("字符%c出现了%d次\n",ch,count);
	return 0;
}
